<%- include('../partials/header') %>

<div class="row-between">
  <h1>Manage products</h1>
  <a class="btn" href="/admin/products/new">Add product</a>
</div>

<div class="table-wrap">
  <table class="table">
    <thead>
      <tr><th></th><th>Name</th><th>Category</th><th>Price</th><th>Featured</th><th></th></tr>
    </thead>
    <tbody>
      <% products.forEach(function (p) { %>
        <tr>
          <td><img class="thumb" src="<%= p.image %>" alt=""></td>
          <td><%= p.name %></td>
          <td><%= p.category_name %></td>
          <td><%= money(p.price) %></td>
          <td><%= p.featured ? 'Yes' : 'No' %></td>
          <td><a href="/admin/products/<%= p.id %>/edit">Edit</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
