# Copy to .env next to app.js and edit. Never commit .env.
# Every value is optional: the defaults match a single-server install.

# database (set DB_HOST to the private address of the DB server when it is separate)
DB_HOST=localhost
DB_PORT=3306
DB_USER=shop
DB_PASSWORD=shoppass123
DB_NAME=shop

# signs the session cookie; use a long random string, the same on every app server
SESSION_SECRET=change-me
# salt for the hashed visitor ids in the analytics tab, the same on every app server
ANALYTICS_SALT=change-me-too

# product images: leave empty to keep them on local disk (public/uploads),
# or set a bucket name to store them in S3 (the instance role needs s3:PutObject and s3:GetObject on it)
UPLOADS_BUCKET=
AWS_REGION=ap-south-1
